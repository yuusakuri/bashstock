#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

project_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd -P)"
readonly project_root

PATH="${project_root}/libexec:${PATH}"
export PATH
FLAGS_GETOPT_CMD='mytool-getopt'
export FLAGS_GETOPT_CMD

source "${project_root}/src/settings/settings.sh"
source "${project_root}/src/output/output.sh"
source "${project_root}/src/library.sh"
source "${project_root}/vendor/shflags/shflags"
source "${project_root}/src/cli/cli.sh"

cli::run "$@"
