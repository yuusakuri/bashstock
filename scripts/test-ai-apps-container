#!/usr/bin/env bash
# shellcheck disable=SC1091

set -euo pipefail

# Run inside a disposable Ubuntu or Fedora container as root.
source /etc/os-release
if [[ "${ID}" == fedora ]]; then
  dnf install -y curl ca-certificates perl perl-JSON-PP findutils tar gzip
else
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y curl ca-certificates perl
fi
source /opt/bashstock.sh
major="${VERSION_ID%%.*}"

# @description Write the installed version of a system package.
package_version() {
  if [[ "${ID}" == fedora ]]; then
    rpm -q --qf '%{VERSION}-%{RELEASE}\n' "$1"
  else
    dpkg-query -W -f='${Version}\n' "$1"
  fi
}

# Claude Code: the previous and the newest stable package, from the signed repository.
if [[ "${ID}" == ubuntu && "${major}" -lt 20 ]]; then
  status=0
  claude-code::install || status="$?"
  [[ "${status}" -eq 69 ]]
  [[ ! -e /etc/apt/sources.list.d/claude-code.list ]]
else
  versions="$(claude-code::versions)"
  latest="$(printf '%s\n' "${versions}" | tail -n 1)"
  previous="$(printf '%s\n' "${versions}" | tail -n 2 | head -n 1)"
  printf 'Claude Code versions: %s, %s\n' "${previous}" "${latest}"
  claude-code::install "${previous}"
  claude-code::install "${previous}"
  [[ "$(package_version claude-code)" == "${previous}" ]]
  claude-code::install
  [[ "$(package_version claude-code)" == "${latest}" ]]
  [[ "$(/usr/bin/claude --version)" == "${latest%-*}"* ]]
  if [[ "${ID}" == fedora ]]; then
    [[ "$(stat -c %a /etc/pki/rpm-gpg/RPM-GPG-KEY-claude-code)" == 644 ]]
    dnf repoquery --quiet --repo=claude-code claude-code | grep -q claude-code
  else
    [[ "$(stat -c %a /etc/apt/keyrings/claude-code.asc)" == 644 ]]
    apt-get update 2>&1 | tee /tmp/bashstock-apt-update.log
    if grep -E '^(E|W):' /tmp/bashstock-apt-update.log; then exit 1; fi
  fi
fi

# Codex: the previous release, then the newest, from OpenAI's installer.
versions="$(codex::versions)"
latest="$(printf '%s\n' "${versions}" | tail -n 1)"
previous="$(printf '%s\n' "${versions}" | tail -n 2 | head -n 1)"
printf 'Codex versions: %s, %s\n' "${previous}" "${latest}"
codex::install "${previous}"
[[ "$("${HOME}/.local/bin/codex" --version)" == *" ${previous}" ]]
codex::install
[[ "$("${HOME}/.local/bin/codex" --version)" == *" ${latest}" ]]
grep -Fq "${HOME}/.local/bin" "${HOME}/.bashrc"

# ChatGPT: OpenAI supports Ubuntu 24.04 or later and Fedora 43 or later.
if [[ ("${ID}" == ubuntu && "${major}" -ge 24) || ("${ID}" == fedora && "${major}" -ge 43) ]]; then
  latest="$(chatgpt::versions | tail -n 1)"
  chatgpt::install
  chatgpt::install "${latest}"
  [[ "$(package_version chatgpt)" == "${latest}"* ]]
  [[ -x /usr/bin/chatgpt ]]
else
  status=0
  chatgpt::install || status="$?"
  [[ "${status}" -eq 69 ]]
  if package_version chatgpt >/dev/null 2>&1; then exit 1; fi
fi
