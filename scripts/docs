#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

# Generate docs/reference from the shdoc comments in src/. With --check, the
# generated files are compared with the committed ones instead of written.

project_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd -P)"
readonly project_root
readonly shdoc="${project_root}/vendor/shdoc/shdoc"
readonly reference="${project_root}/docs/reference"

# @description Write the library modules in the order that scripts/build combines them.
docs::modules() {
  printf '%s\n' settings console number string regex array arguments completion help \
    system command shell terminal path prompt time log json option file os \
    os-darwin os-ubuntu os-fedora \
    user aws git net util package install android android-avd desktop
}

# @description Write the Markdown anchor that shdoc gives a function heading.
#
# @arg $1 string Function name.
docs::anchor() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9 _-]//g; s/ /-/g'
}

# @description Write each public function of a module with the first line of its description.
#
# @arg $1 string Module source file.
docs::public-functions() {
  awk '
    /^# @description / { brief = $0; sub(/^# @description /, "", brief); internal = 0; next }
    /^# @internal/ { internal = 1; next }
    /^[a-z][a-z0-9-]*(::[a-z0-9][a-z0-9-]*)+\(\) *\{/ {
      name = $1
      sub(/\(\).*$/, "", name)
      if (!internal && name !~ /::_/) printf "%s\t%s\n", name, brief
      brief = ""; internal = 0
    }
  ' "$1"
}

# @description Write the reference index of every module and public function.
docs::index() {
  local module='' name='' brief=''
  cat <<'HEADER'
# 関数リファレンス

BashStockが公開する関数をモジュールごとに示します。
各関数の引数、出力、終了状態、例は、モジュールのページと`help::show 関数名`で確認できます。
このファイルと`modules/`は`scripts/docs`が`src/`のshdocコメントから生成します。直接編集しないでください。

関数名と入出力の規則は[ライブラリ仕様](../specifications/library.md)、名前付き引数とTab補完は[名前付き引数とTab補完の仕様](../specifications/named-arguments.md)で定義します。

`-as-root`で終わる関数は、通常権限と管理者権限のどちらで実行するかを呼び出し側が選べる操作です。
管理者権限を常に必要とする操作と、書き込み権限が不足した場合に昇格する操作は、関数名に`-as-root`を付けません。
HEADER
  while IFS= read -r module; do
    [[ -n "$(docs::public-functions "${project_root}/src/${module}.sh")" ]] || continue
    printf '\n## [`%s`](modules/%s.md)\n\n| 関数 | 説明 |\n|---|---|\n' "${module}" "${module}"
    while IFS=$'\t' read -r name brief; do
      printf '| [`%s`](modules/%s.md#%s) | %s |\n' "${name}" "${module}" "$(docs::anchor "${name}")" "${brief}"
    done < <(docs::public-functions "${project_root}/src/${module}.sh")
  done < <(docs::modules)
}

# @description Generate the reference into a directory.
#
# @arg $1 string Output directory.
docs::generate() {
  local output="$1" module=''
  mkdir -p "${output}/modules"
  while IFS= read -r module; do
    gawk -f "${shdoc}" <"${project_root}/src/${module}.sh" >"${output}/modules/${module}.md"
  done < <(docs::modules)
  docs::index >"${output}/functions.md"
}

# @description Generate the reference, or compare it with the committed files when given --check.
#
# @option --check Report generated files that differ from the committed ones and fail.
main() {
  local temporary='' status=0
  command -v gawk >/dev/null 2>&1 || { printf 'docs: gawk is required to run shdoc.\n' >&2; return 69; }
  [[ -f "${shdoc}" ]] || { printf 'docs: run git submodule update --init --recursive first.\n' >&2; return 69; }
  case "${1:-}" in
    '')
      rm -rf -- "${reference}/modules"
      docs::generate "${reference}"
      ;;
    --check)
      temporary="$(mktemp -d)"
      docs::generate "${temporary}"
      diff -ru "${reference}/modules" "${temporary}/modules" || status=1
      diff -u "${reference}/functions.md" "${temporary}/functions.md" || status=1
      rm -rf -- "${temporary}"
      [[ "${status}" -eq 0 ]] || printf 'docs: docs/reference is out of date; run scripts/docs.\n' >&2
      return "${status}"
      ;;
    *)
      printf 'usage: scripts/docs [--check]\n' >&2
      return 64
      ;;
  esac
}

main "$@"
