#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

project_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd -P)"
readonly project_root
# Modules that the OS providers and every namespace module depend on.
core_modules=(
  settings console number string regex array arg help
  system command shell terminal path time log json option file os
)
readonly core_modules
build_staging_root=''

# @description Remove the temporary build directory.
build::_cleanup() {
  if [[ -n "${build_staging_root}" ]]; then
    rm -rf -- "${build_staging_root}"
  fi
}

# @description Write one named source module without its shebang.
build::_write-module() {
  local name="$1"
  printf '# Source: src/%s.sh\n' "${name}"
  tail -n +2 -- "${project_root}/src/${name}.sh"
  printf '\n'
}

# @description Write the namespace modules that follow the OS providers, in name order.
build::_after-platform-modules() {
  local path='' name=''
  for path in "${project_root}"/src/*.sh; do
    name="$(basename -- "${path}" .sh)"
    case " ${core_modules[*]} " in *" ${name} "*) continue ;; esac
    [[ "${name}" == os-* ]] || printf '%s\n' "${name}"
  done | LC_ALL=C sort
}

# @description Combine the license, library modules, OS providers, and execution entry point.
build::_write-library() {
  local before_platform=(runtime/header "${core_modules[@]}")
  local after_platform=()
  local module=''
  while IFS= read -r module; do
    after_platform+=("${module}")
  done < <(build::_after-platform-modules)
  after_platform+=(runtime/operations runtime/footer)

  printf '#!/usr/bin/env bash\n'
  printf '# Zero-argument functions validate arity; regex subshells preserve BASH_REMATCH.\n'
  printf '# shellcheck disable=SC2119,SC2120,SC2234\n'
  printf '# Generated by scripts/build. Edit src/ instead of this file.\n'
  sed 's/^/# /' "${project_root}/LICENSE"
  printf '\n'

  for module in "${before_platform[@]}"; do
    build::_write-module "${module}"
  done

  # shellcheck disable=SC2016 # Emit the provider selection for runtime.
  printf 'case "$(platform::_identifier)" in\n  darwin)\n'
  build::_write-module os-darwin
  printf '    ;;\n  ubuntu)\n'
  build::_write-module os-ubuntu
  printf '    ;;\n  fedora)\n'
  build::_write-module os-fedora
  printf '    ;;\n  *) ;;\nesac\n\n'

  for module in "${after_platform[@]}"; do
    build::_write-module "${module}"
  done
}

# @description Build and syntax-check the standalone library before publishing it to dist/.
main() {
  if [[ "$#" -ne 0 ]]; then
    return 64
  fi

  local distribution_root="${project_root}/dist"
  local output=''

  command -v mktemp >/dev/null 2>&1 || return 69
  mkdir -p "${distribution_root}"
  build_staging_root="$(mktemp -d "${distribution_root}/.build.XXXXXX")" || return 74
  trap build::_cleanup EXIT
  output="${build_staging_root}/bashstock.sh"

  build::_write-library >"${output}"
  bash -n "${output}"
  chmod 644 "${output}"
  mv -f -- "${output}" "${distribution_root}/bashstock.sh"
}

main "$@"
