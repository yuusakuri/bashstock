#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

project_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd -P)"
readonly project_root
build_staging_root=''

### Remove the temporary build directory.
###
### Arguments
###
### This function takes no arguments.
build::_cleanup() {
  if [[ -n "${build_staging_root}" ]]; then
    rm -rf -- "${build_staging_root}"
  fi
}

### Copy the entry point, the modules, and the privileged commands into a directory.
###
### Arguments
###
### * distribution_directory - The directory that receives the library files.
build::_copy-library() {
  local distribution_directory="${1}"

  mkdir -p "${distribution_directory}/src" "${distribution_directory}/libexec"
  cp "${project_root}/bashstock.sh" "${distribution_directory}/bashstock.sh"
  cp "${project_root}/src/"*.sh "${distribution_directory}/src/"
  cp -R "${project_root}/libexec/." "${distribution_directory}/libexec/"
  cp "${project_root}/LICENSE" "${distribution_directory}/LICENSE"

  chmod 644 "${distribution_directory}/bashstock.sh" \
    "${distribution_directory}/src/"*.sh \
    "${distribution_directory}/LICENSE"
  chmod 755 "${distribution_directory}/libexec/"*
}

### Generate the release archive from the source tree.
###
### Arguments
###
### This function takes no arguments.
main() {
  if [[ "$#" -ne 0 ]]; then
    return 64
  fi

  local distribution_root="${project_root}/dist"
  local distribution_directory="${distribution_root}/bashstock"
  local archive="${distribution_root}/bashstock.tar.gz"
  local staging_directory=''

  command -v mktemp >/dev/null 2>&1 || return 69
  command -v tar >/dev/null 2>&1 || return 69

  build_staging_root="$(mktemp -d "${TMPDIR:-/tmp}/bashstock-build.XXXXXX")" || return 74
  staging_directory="${build_staging_root}/bashstock"
  trap build::_cleanup EXIT

  build::_copy-library "${staging_directory}"

  mkdir -p "${distribution_root}"
  rm -rf -- "${distribution_directory}"
  rm -f -- "${archive}"
  mv "${staging_directory}" "${distribution_directory}"
  tar -czf "${archive}" -C "${distribution_root}" bashstock
}

main "$@"
