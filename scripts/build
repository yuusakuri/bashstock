#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

project_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd -P)"
readonly project_root
build_staging_root=''

### Remove the temporary build directory.
###
### Arguments
###
### This function takes no arguments.
build::_cleanup() {
  if [[ -n "${build_staging_root}" ]]; then
    rm -rf -- "${build_staging_root}"
  fi
}

### Write one src/*.sh module with its shebang line removed.
###
### Arguments
###
### * name - The module name, without the src/ prefix or .sh suffix.
build::_write-module() {
  local name="${1}"
  tail -n +2 -- "${project_root}/src/${name}.sh"
  printf '\n'
}

### Write the library entry point into a distribution directory.
###
### Arguments
###
### * distribution_directory - The directory that receives bashstock.sh.
build::_write-library() {
  local distribution_directory="${1}"
  local output="${distribution_directory}/bashstock.sh"
  local before_platform=(
    settings console number string regex array arguments completion
    system command shell terminal path
    prompt time log
    json option file
    os
  )
  local after_platform=(
    user
    aws
    git
    net
    util
  )
  local module=''

  {
    cat <<'HEADER'
#!/usr/bin/env bash
# This file is generated by scripts/build from src/*.sh. Do not edit directly.

if [ -n "${_BASHSTOCK_LOADED:-}" ]; then
  return 0
fi
_BASHSTOCK_LOADED=1

if [ -z "${BASHSTOCK_ROOT:-}" ]; then
  BASHSTOCK_ROOT="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
fi

HEADER

    for module in "${before_platform[@]}"; do
      build::_write-module "${module}"
    done

    cat <<'PROVIDERS'
case "$(platform::_identifier)" in
  darwin)
PROVIDERS
    build::_write-module 'os-darwin'
    printf '    ;;\n  ubuntu)\n'
    build::_write-module 'os-ubuntu'
    printf '    ;;\n  fedora)\n'
    build::_write-module 'os-fedora'
    printf '    ;;\n  *)\n    ;;\nesac\n\n'

    for module in "${after_platform[@]}"; do
      build::_write-module "${module}"
    done

    printf 'arg::completion::register-all\n'
  } >"${output}"

  chmod 755 "${output}"
}

### Generate the release archive from the source tree.
###
### Arguments
###
### This function takes no arguments.
main() {
  if [[ "$#" -ne 0 ]]; then
    return 64
  fi

  local distribution_root="${project_root}/dist"
  local distribution_directory="${distribution_root}/bashstock"
  local archive="${distribution_root}/bashstock.tar.gz"
  local staging_directory=''

  command -v mktemp >/dev/null 2>&1 || return 69
  command -v tar >/dev/null 2>&1 || return 69

  build_staging_root="$(mktemp -d "${TMPDIR:-/tmp}/bashstock-build.XXXXXX")" || return 74
  staging_directory="${build_staging_root}/bashstock"
  trap build::_cleanup EXIT

  mkdir -p "${staging_directory}/libexec"
  build::_write-library "${staging_directory}"
  cp -R "${project_root}/libexec/." "${staging_directory}/libexec/"
  cp "${project_root}/LICENSE" "${staging_directory}/LICENSE"

  mkdir -p "${distribution_root}"
  rm -rf -- "${distribution_directory}"
  rm -f -- "${archive}"
  mv "${staging_directory}" "${distribution_directory}"
  tar -czf "${archive}" -C "${distribution_root}" bashstock
}

main "$@"
