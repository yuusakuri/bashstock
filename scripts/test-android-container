#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2317,SC2329

set -euo pipefail

# Run as root from the checkout in a disposable Ubuntu or Fedora container started with
# --device /dev/kvm. The prerequisites match what a desktop user installs
# before Android Studio: a JDK for sdkmanager and avdmanager, and the
# libraries that the emulator loads even without a window.
source /etc/os-release
case "${ID}" in
  ubuntu)
    export DEBIAN_FRONTEND=noninteractive
    apt-get update >/dev/null
    apt-get install -y --no-install-recommends ca-certificates curl perl iproute2 procps \
      libpulse0 libnss3 libxcomposite1 libxcursor1 libxdamage1 libxi6 libxtst6 libxkbfile1 \
      libgl1 libdbus-1-3 >/dev/null
    apt-get install -y --no-install-recommends openjdk-21-jdk-headless >/dev/null 2>&1 ||
      apt-get install -y --no-install-recommends openjdk-17-jdk-headless >/dev/null
    apt-get install -y --no-install-recommends libasound2t64 >/dev/null 2>&1 ||
      apt-get install -y --no-install-recommends libasound2 >/dev/null
    ;;
  fedora)
    dnf install -y ca-certificates curl perl-JSON-PP perl-File-Temp iproute procps-ng which \
      pulseaudio-libs nss libXcomposite libXcursor libXdamage libXi libXtst libxkbfile \
      mesa-libGL dbus-libs alsa-lib java-latest-openjdk-headless >/dev/null
    ;;
esac

source ./dist/bashstock.sh
printf '%s %s %s\n' "${PRETTY_NAME}" "$(uname -m)" "$(getconf GNU_LIBC_VERSION)"
java -version 2>&1 | head -n 1

if [[ "$(uname -m)" != x86_64 ]]; then
  # Google publishes the Android CLI only for x86_64 Linux.
  export HOME="${RUNNER_TEMP}/bashstock-android-home"
  mkdir -p "${HOME}"
  status=0
  android::sdk::install 2>/dev/null || status="$?"
  [[ "${status}" -eq 69 ]]
  [[ ! -e "${HOME}/.local/bin/android" && ! -e "${HOME}/Android/Sdk" ]]
  printf 'Android CLI reports this CPU as unsupported with status 69.\n'
  exit 0
fi

bash ./scripts/test-android-linux
