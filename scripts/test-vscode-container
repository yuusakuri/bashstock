#!/usr/bin/env bash
# shellcheck disable=SC1091

set -euo pipefail

source /opt/bashstock.sh
latest="$(vscode::versions | tail -n 1)"
[[ -n "$latest" ]]
printf 'VS Code version: %s\n' "$latest"
source /etc/os-release
if [[ "$ID" == ubuntu && "$VERSION_ID" == 18.04 ]]; then
  # VS Code 1.86 and later need glibc 2.28; Ubuntu 18.04 has 2.27.
  [[ "$latest" == 1.85.* ]]
fi

vscode::install
vscode::install "$latest"
if [[ "$ID" == ubuntu ]]; then
  installed="$(dpkg-query -W -f='${Version}' code)"
else
  installed="$(rpm -q --qf '%{EVR}' code)"
fi
[[ "$installed" == "$latest" ]]
if [[ "$ID" == ubuntu ]]; then
  # The package must not add a second definition of the repository.
  if grep -E '^[[:space:]]*deb[[:space:]]' /etc/apt/sources.list.d/vscode.list; then exit 1; fi
  [[ ! -e /etc/apt/trusted.gpg.d/microsoft.gpg ]]
  apt-get update 2>&1 | tee /tmp/bashstock-vscode-apt-update.log
  if grep -E '^(E|W):' /tmp/bashstock-vscode-apt-update.log; then exit 1; fi
fi

# VS Code refuses to start as root without its own sandbox and data directory.
data_directory="$(mktemp -d)"
[[ "$(code --no-sandbox --user-data-dir "$data_directory" --version | head -n 1)" == "${latest%%-*}" ]]
