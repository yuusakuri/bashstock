#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2016

set -euo pipefail

# Run as the sudo user tester inside an Ubuntu container whose PID 1 is
# systemd, after scripts/test-ubuntu-setup-container. GNOME settings are
# written through dconf on a D-Bus session bus, so a later session reads them
# back from the user's dconf database.
source /etc/os-release
sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  dbus-x11 dconf-cli dconf-gsettings-backend gsettings-desktop-schemas gnome-settings-daemon-common libglib2.0-bin \
  ibus ibus-mozc keyboard-configuration udev >/dev/null

# @description Run a BashStock command in a new D-Bus session.
in_session() {
  dbus-run-session -- bash -c 'source /opt/bashstock.sh && "$@"' bashstock "$@"
}

# The installer of a Japanese desktop leaves the JP layout as the input source.
in_session gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'jp')]"

export GIT_EMAIL=tester@example.invalid GIT_USERNAME='Setup Tester'
in_session ubuntu::setup-desktop

printf '== GNOME settings in a new session\n'
sources="$(in_session gsettings get org.gnome.desktop.input-sources sources)"
printf '%s\n' "$sources"
[[ "$sources" == "[('ibus', 'mozc-jp'), ('xkb', 'us')]" ]]
[[ "$(in_session gsettings get org.gnome.desktop.wm.preferences button-layout)" == "'appmenu:minimize,maximize,close'" ]]

printf '== keyboard\n'
grep -x 'XKBLAYOUT="us"' /etc/default/keyboard
query="$(systemd-hwdb query 'evdev:input:b0003v1234p5678e0111')"
printf '%s\n' "$query"
grep -Fx 'KEYBOARD_KEY_7008a=henkan' <<<"$query"
grep -Fx 'KEYBOARD_KEY_7008b=muhenkan' <<<"$query"
grep -Fx 'KEYBOARD_KEY_70090=henkan' <<<"$query"
grep -Fx 'KEYBOARD_KEY_70091=muhenkan' <<<"$query"

printf '== IME shortcuts in a new session\n'
# Reapplying the shortcuts keeps a single entry for each direction.
in_session gnome::input-source::setup-ime-keys
schema='org.gnome.settings-daemon.plugins.media-keys'
base='/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings'
bindings="$(in_session gsettings get "$schema" custom-keybindings)"
[[ "$(grep -o 'bashstock-ime-off/' <<<"$bindings" | wc -l)" -eq 1 ]]
[[ "$(grep -o 'bashstock-ime-on/' <<<"$bindings" | wc -l)" -eq 1 ]]
[[ "$(in_session gsettings get "$schema.custom-keybinding:$base/bashstock-ime-off/" binding)" == "'Muhenkan'" ]]
[[ "$(in_session gsettings get "$schema.custom-keybinding:$base/bashstock-ime-on/" binding)" == "'Henkan_Mode'" ]]
[[ "$(in_session gsettings get "$schema.custom-keybinding:$base/bashstock-ime-off/" command)" == "\"ibus engine 'xkb:us::eng'\"" ]]
[[ "$(in_session gsettings get "$schema.custom-keybinding:$base/bashstock-ime-on/" command)" == "\"ibus engine 'mozc-jp'\"" ]]

printf '== Mozc\n'
grep -Fx 'active_on_launch: True' "$HOME/.config/mozc/ibus_config.textproto"
# Without its engines block, Mozc offers IBus no engine at all.
grep -Fx '  name : "mozc-jp"' "$HOME/.config/mozc/ibus_config.textproto"
