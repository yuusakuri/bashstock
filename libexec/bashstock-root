#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

project_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd -P)"
readonly project_root

unset _BASHSTOCK_LOADED
BASHSTOCK_ROOT="${project_root}"
# shellcheck disable=SC2034 # The sourced library reads this value.
readonly BASHSTOCK_ROOT

# shellcheck disable=SC1091 # bashstock.sh sits beside libexec/.
source "${project_root}/bashstock.sh"

### Run the library function that implements one operation name.
###
### Arguments
###
### * operation - The name of the operation to run.
### * ... - The arguments that the library function receives.
root::_dispatch() {
  if [[ "$#" -lt 1 ]]; then
    return 64
  fi

  local operation="$1"
  shift
  case "${operation}" in
    append-text)
      file::append-text "$@"
      ;;
    replace-text)
      file::replace-text "$@"
      ;;
    replace-text-in-files)
      file::replace-text-in-files "$@"
      ;;
    replace-or-append-text)
      file::replace-or-append-text "$@"
      ;;
    create-system-user)
      platform::_create-system-user "$@"
      ;;
    create-login-user)
      platform::_create-login-user "$@"
      ;;
    change-owner-recursively)
      platform::_change-owner-recursively "$@"
      ;;
    *)
      return 64
      ;;
  esac
}

### Reject unprivileged callers and dispatch one privileged operation.
###
### Arguments
###
### * operation - The name of the operation to run.
### * ... - The arguments that the library function receives.
main() {
  if [[ "${EUID}" -ne 0 ]]; then
    return 77
  fi

  root::_dispatch "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
